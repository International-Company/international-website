# ── Database (Railway → Add PostgreSQL, then reference its variable) ──
DATABASE_URL="postgresql://user:password@host:5432/railway"

# ── Admin panel (/admin) ──
# The password you type to open the control panel.
ADMIN_PASSWORD="choose-a-strong-password"
# Any long random string (32+ chars) used to sign the session cookie.
AUTH_SECRET="generate-a-long-random-secret-at-least-32-characters"

# ── Optional ──
# Public site URL, used by sitemap / Open Graph.
NEXT_PUBLIC_SITE_URL="https://international0.com"
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (leave empty to disable).
NEXT_PUBLIC_GA_ID=""
